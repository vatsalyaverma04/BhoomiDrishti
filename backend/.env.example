# BhoomiDrishti AI - Environment Configuration
# ================================================

# 1. Google Gemini API Key (100% Free Tier: 15 Requests/Min, 1,500 Requests/Day)
# Obtain from: https://aistudio.google.com/ -> Click 'Get API key' -> 'Create API key'
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server Network Settings (Use 0.0.0.0 for cloud deployments like Render)
HOST=0.0.0.0
PORT=8000

# 2. Supabase Cloud PostgreSQL Database (Direct cloud sync with local JSON fallback)
# Find your credentials on https://supabase.com -> Project Settings -> API:
# - Project URL: https://<your-project-id>.supabase.co
# - anon public / service_role key: eyJhbGciOi...
SUPABASE_URL=
SUPABASE_KEY=
